  "mongosh_apply_validators": {
    "$comment": "Ejecutar en mongosh para aplicar validación nativa en MongoDB",
    "usage": [
      "use room",
      "db.runCommand({ collMod: 'inmueble', validator: { $jsonSchema: <schema de esta colección> }, validationLevel: 'moderate', validationAction: 'warn' })"
