    "validationLevel_options": {
      "off":      "Sin validación",
      "moderate": "Valida documentos nuevos y actualizados (no los existentes que violen el schema)",
      "strict":   "Valida todos los writes — puede romper datos existentes"
    },
    "validationAction_options": {
      "warn":  "Loguea un warning pero permite el write",
      "error": "Rechaza el write si viola el schema"
